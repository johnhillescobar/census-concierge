# Keep the index focused on source. Everything here is generated, vendored,
# or large enough to drown out the code that matters.

.venv/
__pycache__/
*.pyc
node_modules/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated from the OpenAPI schema — never hand-edited.
packages/client/

# Index artifacts and cached Census metadata: large, regenerable, and not source.
data/
index_store/
*.sqlite
*.duckdb
*.parquet

# Secrets
.env
.env.*
!.env.example

# NOTE: evidence/latest.json is deliberately NOT ignored. It is the scoreboard,
# and the coding agent should always be able to read it.

*.pdf

# In this folder I store markdown files for learning purposes.
docs/learning/

# In this folder I store code for learning purposes.
docs/learning/code/

# In this folder I store data for learning purposes.
docs/learning/data/

# In this folder I store notebooks for learning purposes.
docs/learning/notebooks/

# In this folder I store reports for learning purposes.
docs/learning/reports/