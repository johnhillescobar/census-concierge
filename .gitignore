# NOTE: this is not .cursorignore. That file controls what the coding agent may
# read; this one controls what git tracks. Several entries differ deliberately —
# see the comments below.

# Playwright MCP local snapshots (not evidence)
.playwright-mcp/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# Index artifacts: large, regenerable, and rebuilt from committed inputs.
*.npz
index_store/
data/raw/
*.sqlite
*.duckdb
*.parquet

# Generated reports
*.pdf

# --- deliberately NOT ignored -----------------------------------------------
#
# data/synthetic_questions.json  ~600 KB of LLM-generated questions. Committed
#   so the index is reproducible and so a human can read what was generated for
#   a table and spot garbage. (.cursorignore hides data/ from the agent; that is
#   a separate concern.)
#
# evidence/latest.json  the scoreboard. check_budgets.py reads it, including in
#   CI, so it must be in the repo.
#
# packages/client/  generated from the OpenAPI schema, but CI regenerates it and
#   fails if the committed copy is stale. That check requires it to be tracked.

# Experiment scratch: cached embedding matrices, regenerable and large.
experiments/cache/

# In this folder I store markdown files for learning purposes.
docs/learning/

# In this folder I store code for learning purposes.
docs/learning/code/

# In this folder I store data for learning purposes.
docs/learning/data/

# In this folder I store notebooks for learning purposes.
docs/learning/notebooks/

# In this folder I store reports for learning purposes.
docs/learning/reports/
