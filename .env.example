# Copy to .env. Never commit the real file — .gitignore keeps it out and
# pre-commit's detect-private-key is the backstop.
#
# In production these come from the platform's environment, not from a file.
# Nothing under api/src reads .env; only the build and eval scripts do.

# Building the index: synthetic questions and embeddings. Slice 0.
OPENAI_API_KEY=

# Live data. Slice 1 onward — slice 0 needs no key at all, because the
# groups/variables/geography metadata endpoints are public.
CENSUS_API_KEY=
