{
  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "reason": {
            "description": "How this table differs: universe, distribution versus median, collapsed table, race iteration, or related table.",
            "title": "Reason",
            "type": "string"
          },
          "table_id": {
            "description": "ACS table ID.",
            "title": "Table Id",
            "type": "string"
          }
        },
        "required": [
          "table_id",
          "reason"
        ],
        "title": "Alternative",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "description": "The user's question. Leading and trailing whitespace is stripped.",
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "alternatives": {
            "description": "Related tables with the reason they differ from the selection.",
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "answer": {
            "description": "Natural-language answer.",
            "title": "Answer",
            "type": "string"
          },
          "attempted_years": {
            "description": "Unique vintages for which a Census request was issued.",
            "items": {
              "type": "integer"
            },
            "title": "Attempted Years",
            "type": "array"
          },
          "failed_years": {
            "description": "Unique attempted vintages with at least one failed or timed-out call.",
            "items": {
              "type": "integer"
            },
            "title": "Failed Years",
            "type": "array"
          },
          "geoid": {
            "description": "AFFGEOID of the selected geography; empty when many areas are returned.",
            "title": "Geoid",
            "type": "string"
          },
          "legs": {
            "description": "Per-request outcome in requested order, including failed legs.",
            "items": {
              "$ref": "#/components/schemas/RequestLeg"
            },
            "title": "Legs",
            "type": "array"
          },
          "moe": {
            "description": "Per-row 90% margins, keyed to each estimate's matching M variable.",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Moe",
            "type": "array"
          },
          "omission_reasons": {
            "description": "Reason code per omitted year, same order as omitted_years.",
            "items": {
              "type": "string"
            },
            "title": "Omission Reasons",
            "type": "array"
          },
          "omitted_years": {
            "description": "Requested years that were not attempted.",
            "items": {
              "type": "integer"
            },
            "title": "Omitted Years",
            "type": "array"
          },
          "requested_years": {
            "description": "Years asked of fetch_data, de-duplicated in first-requested order.",
            "items": {
              "type": "integer"
            },
            "title": "Requested Years",
            "type": "array"
          },
          "rows": {
            "description": "Census rows as returned. Each row carries GEO_ID (AFFGEOID); empty when the row is a combined total rather than a published area.",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "succeeded_years": {
            "description": "Unique attempted vintages with at least one successful HTTP call.",
            "items": {
              "type": "integer"
            },
            "title": "Succeeded Years",
            "type": "array"
          },
          "table_id": {
            "description": "Selected ACS table ID.",
            "title": "Table Id",
            "type": "string"
          },
          "universe": {
            "description": "Published universe of the selected table.",
            "title": "Universe",
            "type": "string"
          },
          "urls": {
            "description": "Key-redacted Census API URLs, one per attempted request, in requested order.",
            "items": {
              "type": "string"
            },
            "title": "Urls",
            "type": "array"
          },
          "warnings": {
            "description": "Non-blocking guards: overlapping_vintage, moe_not_significant, geography_unsupported, ambiguous_place, universe_mismatch, median_not_aggregatable, moe_aggregation_degraded, zcta_not_zip, geography_not_nested, acs1_geography_ineligible, vintage_gap_2020, boundary_change_2020, measure_unavailable, variable_not_in_vintage.",
            "items": {
              "$ref": "#/components/schemas/AskWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "urls",
          "requested_years",
          "attempted_years",
          "succeeded_years",
          "failed_years",
          "omitted_years",
          "omission_reasons",
          "legs",
          "rows",
          "moe",
          "geoid",
          "universe",
          "table_id",
          "alternatives",
          "warnings"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "AskWarning": {
        "properties": {
          "code": {
            "description": "Machine-readable warning code.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "What was raised, in one sentence.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "AskWarning",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RequestLeg": {
        "properties": {
          "detail": {
            "description": "Redacted reason when ok is false; empty on success.",
            "title": "Detail",
            "type": "string"
          },
          "for_spec": {
            "default": "",
            "description": "Census for= clause for this geography leg; empty when the built URL is used.",
            "title": "For Spec",
            "type": "string"
          },
          "ok": {
            "description": "Whether this HTTP call returned parseable rows.",
            "title": "Ok",
            "type": "boolean"
          },
          "status_code": {
            "description": "Census HTTP status; 0 on timeout or transport failure.",
            "title": "Status Code",
            "type": "integer"
          },
          "url": {
            "description": "Key-redacted Census API URL for this year.",
            "title": "Url",
            "type": "string"
          },
          "year": {
            "description": "Vintage end year for this Census request.",
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "url",
          "ok",
          "status_code",
          "detail"
        ],
        "title": "RequestLeg",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "census-concierge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ask": {
      "post": {
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Ask"
      }
    }
  }
}
