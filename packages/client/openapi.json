{
  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "reason": {
            "description": "How this table differs: universe, distribution versus median, collapsed table, race iteration, or related table.",
            "title": "Reason",
            "type": "string"
          },
          "table_id": {
            "description": "ACS table ID.",
            "title": "Table Id",
            "type": "string"
          }
        },
        "required": [
          "table_id",
          "reason"
        ],
        "title": "Alternative",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "description": "The user's question. Leading and trailing whitespace is stripped.",
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "alternatives": {
            "description": "Related tables with the reason they differ from the selection.",
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "answer": {
            "description": "Natural-language answer.",
            "title": "Answer",
            "type": "string"
          },
          "geoid": {
            "description": "AFFGEOID of the selected geography; empty when many areas are returned.",
            "title": "Geoid",
            "type": "string"
          },
          "moe": {
            "description": "Per-row 90% margins, keyed to each estimate's matching M variable.",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Moe",
            "type": "array"
          },
          "rows": {
            "description": "Census rows as returned. Each row carries GEO_ID (AFFGEOID).",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "table_id": {
            "description": "Selected ACS table ID.",
            "title": "Table Id",
            "type": "string"
          },
          "universe": {
            "description": "Published universe of the selected table.",
            "title": "Universe",
            "type": "string"
          },
          "url": {
            "description": "Census API URL for this answer. Singular; slice 3 grows urls[].",
            "title": "Url",
            "type": "string"
          },
          "warnings": {
            "description": "Non-blocking guards: overlapping_vintage, moe_not_significant, geography_unsupported, ambiguous_place, universe_mismatch.",
            "items": {
              "$ref": "#/components/schemas/AskWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "url",
          "rows",
          "moe",
          "geoid",
          "universe",
          "table_id",
          "alternatives",
          "warnings"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "AskWarning": {
        "properties": {
          "code": {
            "description": "Machine-readable warning code.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "What was raised, in one sentence.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "AskWarning",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "census-concierge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ask": {
      "post": {
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Ask"
      }
    }
  }
}
